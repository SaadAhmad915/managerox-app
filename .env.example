# Where the Laravel API actually lives. Server-side only — the browser never
# sees this, it just calls this app's own /api and Next forwards the request.
# Local:      http://localhost:8000
# Production: https://your-api-host.example.com
API_ORIGIN=http://localhost:8000

# Leave unset. Only set this to bypass the proxy and call the API directly,
# which needs the CRM and API to be same-site or the session cookie is dropped.
# NEXT_PUBLIC_API_URL=
