# Local development needs none of these — leave the file as it is and the app
# runs PGlite (Postgres compiled to WebAssembly) from a .pglite folder.

# Set in production to point at a hosted Postgres instead. The same schema and
# the same migrations run against both.
# DATABASE_URL=postgresql://user:password@host:5432/managerox

# Where PGlite keeps its files locally. Defaults to .pglite.
# PGLITE_PATH=.pglite

# Only if you open the app as something other than localhost or 127.0.0.1 —
# a LAN address to test on a phone, say. Next's dev server blocks its client
# bundle from any other origin, and the page then hangs on its spinner.
# Exact host only; wildcards and CIDR ranges are ignored.
# DEV_ORIGIN=192.168.1.42
